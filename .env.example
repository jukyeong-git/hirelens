# Application
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# Local development and Alpha use the same hosted Alpha Supabase project; Docker is only for explicit local integration tests.
SUPABASE_ENV=hosted-alpha
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
RESUME_BUCKET=resumes
PROCESSING_QUEUE=resume-analysis

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_STORE=false
AI_PIPELINE_VERSION=v1
AI_SCORECARD_PROMPT_VERSION=scorecard-v1
AI_EVIDENCE_PROMPT_VERSION=evidence-v1
AI_SCHEMA_VERSION=v1

# Worker
WORKER_CONCURRENCY=3
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_MS=2000

# Optional observability
SENTRY_DSN=
