# Application
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# Local development and Alpha use the same hosted Alpha Supabase project; Docker is only for explicit local integration tests.
SUPABASE_ENV=hosted-alpha
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DEMO_PUBLIC_SUBMISSION_CODE=
DATABASE_URL=
RESUME_BUCKET=resumes
PROCESSING_QUEUE=resume_analysis

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_STORE=false
AI_PIPELINE_VERSION=evidence-pipeline-v1
AI_SCORECARD_PROMPT_VERSION=scorecard-v1
AI_EVIDENCE_PROMPT_VERSION=evidence-extraction-prompt-v1
AI_SCHEMA_VERSION=evidence-extraction-schema-v1
AI_MAX_INPUT_TOKENS=24000
AI_MAX_OUTPUT_TOKENS=8000
AI_MAX_TOTAL_TOKENS_PER_RUN=32000
AI_INPUT_COST_MICROUSD_PER_MILLION_TOKENS=0
AI_OUTPUT_COST_MICROUSD_PER_MILLION_TOKENS=0
AI_MAX_COST_MICROUSD_PER_RUN=100000

# Worker
WORKER_CONCURRENCY=3
WORKER_MAX_ATTEMPTS=2
WORKER_POLL_INTERVAL_MS=2000

# Supabase Edge evidence consumer
EVIDENCE_CONSUMER_CRON_SECRET=
EVIDENCE_QUEUE_VISIBILITY_SECONDS=360
# One-time activation guards; set only when running `pnpm edge:activate`.
EDGE_CONSUMER_CONFIRM_ACTIVATION=
EDGE_CONSUMER_NODE_WORKER_STOPPED=

# Optional observability
SENTRY_DSN=
