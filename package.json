{
  "name": "hirelens",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @hirelens/web --filter @hirelens/worker dev",
    "dev:web": "pnpm --filter @hirelens/web dev",
    "dev:worker": "pnpm --filter @hirelens/worker dev",
    "build": "pnpm --filter @hirelens/web build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file=.env.local --import tsx scripts/verify-alpha-db.ts",
    "test:e2e": "playwright test",
    "eval:ai": "tsx scripts/phase0-command.ts eval:ai",
    "privacy:scan": "tsx scripts/privacy-scan.ts",
    "demo:seed-fallback": "node --env-file=.env.local --import tsx scripts/install-demo-fallback.ts",
    "demo:capture-fallback": "playwright test tests/e2e/demo-fallback.spec.ts",
    "db:start": "node --env-file=.env.local --import tsx scripts/db.ts start",
    "db:link": "node --env-file=.env.local --import tsx scripts/db.ts link",
    "db:push": "node --env-file=.env.local --import tsx scripts/db.ts push",
    "db:reset": "node --env-file=.env.local --import tsx scripts/db.ts reset",
    "env:check": "node --env-file=.env.local --import tsx scripts/check-env.ts",
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig*.json eslint.config.mjs .prettierrc.json vitest.config.ts playwright.config.ts apps packages scripts .github/workflows/ci.yml tests/e2e tests/ai-evals"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@next/eslint-plugin-next": "15.5.0",
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "eslint": "9.35.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4",
    "zod": "4.1.5"
  }
}
